  lines:
  - characterName: Fernando
    text: Hey que tal, como te va el dia.
    expression: {fileID: 21300000, guid: 96c6ee650139f8a4a8402e5401d925ad, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 0}
    hasOptions: 0
    options: []
  - characterName: Fernando
    text: He estado trabajando en mis proyectos personales y eso, y tu como vas.
    expression: {fileID: 21300000, guid: 96c6ee650139f8a4a8402e5401d925ad, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 0}
    hasOptions: 1
    options:
    - optionText: Estoy con un tema de Jetpack Compose.
      nextDialogue: {fileID: 11400000, guid: 110e819bc127d1249a82afa896ee28e6, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
    - optionText: Estoy repasando con Ermis, porque la asignatura de Odoo...
