    isFinalButton: 0
    options: []
  - characterName: Jesus
    text: "\xBFPor qu\xE9 lo preguntas?"
    expression: {fileID: 21300000, guid: ffdd1d146e4b34e42a62ab994b7748bd, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 0}
    backgroundOverride: {fileID: 0}
    hasOptions: 0
    isFinalButton: 0
    options:
    - optionText: "Por nada, era por saber, a mi me parece raro tambi\xE9n"
