%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c258d7aa07a5574b92a767b18b37c32, type: 3}
  m_Name: DialogoWelcome
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Varias voces
    text: "\xA1Sorpresa bienvenido!"
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 519c7d0e57a13c94291b700bfdbacc95, type: 3}
    hasOptions: 0
    options: []
  - characterName: Todos
    text: "\xA1Bienvenido feliz cumplea\xF1os!"
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: ecd42771c5b76ef4abf93b669b4c9bf0, type: 3}
    hasOptions: 0
    options: []
  - characterName: Liam
    text: "Feliz cumplea\xF1os buen hombre, estuve lo que quedaba de semana en suspension....
      Pero al final ya volvimos todos."
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: ecd42771c5b76ef4abf93b669b4c9bf0, type: 3}
    hasOptions: 0
    options: []
  - characterName: Aday
    text: Ya les conte la situacion de todo lo que paso.
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: ecd42771c5b76ef4abf93b669b4c9bf0, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jimmi
    text: Concha, no me esperaba eso de Hafid la verdad, lo bueno es que el centro
      esta porfil limpio se podria decir.
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: ecd42771c5b76ef4abf93b669b4c9bf0, type: 3}
    hasOptions: 0
    options: []
  - characterName: Agoney
    text: Por ahora.
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: ecd42771c5b76ef4abf93b669b4c9bf0, type: 3}
    hasOptions: 0
    options: []
  - characterName: Pablo
    text: Tengo hambre... Quiero comer.
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: ecd42771c5b76ef4abf93b669b4c9bf0, type: 3}
    hasOptions: 0
    options: []
  - characterName: Edgar
    text: "\xBFY si pedimos un buen delivery?, Que les parece se\xF1ores."
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: ecd42771c5b76ef4abf93b669b4c9bf0, type: 3}
    hasOptions: 0
    options: []
  - characterName: (Yo)
    text: "(El ni\xF1o este que pone mala cara porque sigue aqui...)"
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: ecd42771c5b76ef4abf93b669b4c9bf0, type: 3}
    hasOptions: 0
    options: []
  - characterName: (Yo)
    text: (Entonces lo hice bien, creo que todo esta bien.)
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: ecd42771c5b76ef4abf93b669b4c9bf0, type: 3}
    hasOptions: 0
    options: []
  - characterName: (Yo)
    text: (Se acabo entonces.)
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 8300000, guid: 77835dd1c80dbab4da285d5aa6d35650, type: 3}
    backgroundOverride: {fileID: 21300000, guid: bb89b65ba262c3845bde73e3b44593c7, type: 3}
    hasOptions: 0
    options: []
