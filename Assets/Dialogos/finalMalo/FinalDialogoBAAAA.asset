MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c258d7aa07a5574b92a767b18b37c32, type: 3}
  m_Name: FinalDialogoBAAAA
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Jesus
    text: Hmmmmmm...
    expression: {fileID: 21300000, guid: 9dd8d6c829eb2c14f9c084126ccf32be, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Mientras no estabas en casa, me puse a buscar algo de comida en la despensa...
    expression: {fileID: 21300000, guid: 15b96650d9d0061419f014e91ab6444e, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Encontr\xE9 esto. Junto con otros 50 botes iguales."
    expression: {fileID: 21300000, guid: eb4fbad06140d7243b67ced940f56b24, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "\xBFTe suena de algo?"
    expression: {fileID: 21300000, guid: eb4fbad06140d7243b67ced940f56b24, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: "(t\xFA)"
    text: (Esas pastillas...)
    expression: {fileID: 21300000, guid: eb4fbad06140d7243b67ced940f56b24, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 0682f1301744ad04aa6ca2a0b5e3abf1, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: . . .
    expression: {fileID: 21300000, guid: eb4fbad06140d7243b67ced940f56b24, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "A m\xED si me suenan. Si las tomas en exceso, puedes perder la memoria."
    expression: {fileID: 21300000, guid: eb4fbad06140d7243b67ced940f56b24, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Me acuerdo que la usamos en uno de nuestros juguetes...
    expression: {fileID: 21300000, guid: 01e209d0ba4cc38408aea47044a5b675, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Aquel d\xEDa no volvi\xF3 a casa... Los padres y la polic\xEDa nos preguntaron."
    expression: {fileID: 21300000, guid: 01e209d0ba4cc38408aea47044a5b675, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Nosotros fingimos no saber nada.
    expression: {fileID: 21300000, guid: f7f186458fc313941bac93e131be3506, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Y ahora est\xE1s t\xFA tom\xE1ndo estas mismas pastillas..."
    expression: {fileID: 21300000, guid: f7f186458fc313941bac93e131be3506, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 1
    options:
    - optionText: (contestar)
      nextDialogue: {fileID: 11400000, guid: e80ab3eb57ff1354497e90efb5b1938d, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
    - optionText: (no decir nada)
      nextDialogue: {fileID: 11400000, guid: 4841eae7e28378d4187655aa297f6116, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
