  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c258d7aa07a5574b92a767b18b37c32, type: 3}
  m_Name: FinalDialogoBAAAAB
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Jesus
    text: . . .
    expression: {fileID: 21300000, guid: 15b96650d9d0061419f014e91ab6444e, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Echo de menos a tu yo del pasado.
    expression: {fileID: 21300000, guid: 7a1f1148a45af9940bbc1a3a3f97a452, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Pareces otra persona completamente diferente...
    expression: {fileID: 21300000, guid: 2abdd9bc3f3e4434d9789b2a6f2ef19c, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: . . .
    expression: {fileID: 21300000, guid: 7a1f1148a45af9940bbc1a3a3f97a452, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Vaya decepci\xF3n..."
    expression: {fileID: 21300000, guid: 7a1f1148a45af9940bbc1a3a3f97a452, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Cuando por fin me reencuentro con mi mejor amigo... Descubro que est\xE1
      tomando pastillas para olvidar su pasado..."
    expression: {fileID: 21300000, guid: 7a1f1148a45af9940bbc1a3a3f97a452, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "\xBFCrees que algo va a cambiar?"
    expression: {fileID: 21300000, guid: 15b96650d9d0061419f014e91ab6444e, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Tu pasado no va a desaparecer.
    expression: {fileID: 21300000, guid: 2abdd9bc3f3e4434d9789b2a6f2ef19c, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Deja de huir de \xE9l. Vuelve conmigo. Volvamos a ser las personas que
      eramos antes."
    expression: {fileID: 21300000, guid: 2abdd9bc3f3e4434d9789b2a6f2ef19c, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Buscaremos juguetes nuevos... Los usaremos hasta que se rompan por completo.
    expression: {fileID: 21300000, guid: 2abdd9bc3f3e4434d9789b2a6f2ef19c, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Como en los viejos tiempos.
    expression: {fileID: 21300000, guid: 2abdd9bc3f3e4434d9789b2a6f2ef19c, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: ac7e8b0d06c2c554fab980af0b7db5f2, type: 3}
    hasOptions: 0
    isFinalButton: 1
    options: []
