%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c258d7aa07a5574b92a767b18b37c32, type: 3}
  m_Name: FinalDialogoBAA
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Jesus
    text: "T\xFA y yo nos conocemos de hace tiempo..."
    expression: {fileID: 21300000, guid: 2abdd9bc3f3e4434d9789b2a6f2ef19c, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Eramos mejores amigos en secundaria.
    expression: {fileID: 21300000, guid: 01e209d0ba4cc38408aea47044a5b675, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Ten\xEDamos muchos juguetes en aquel entonces..."
    expression: {fileID: 21300000, guid: 01e209d0ba4cc38408aea47044a5b675, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: . . .
    expression: {fileID: 21300000, guid: 15b96650d9d0061419f014e91ab6444e, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: No te acuerdas de nada, verdad...
    expression: {fileID: 21300000, guid: 15b96650d9d0061419f014e91ab6444e, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: . . .
    expression: {fileID: 21300000, guid: 15b96650d9d0061419f014e91ab6444e, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Espera . . .
    expression: {fileID: 21300000, guid: 15b96650d9d0061419f014e91ab6444e, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "\xA1\xA1\xA1\xA1TENGO UNA IDEA!!!!"
    expression: {fileID: 21300000, guid: f7f186458fc313941bac93e131be3506, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Te contar\xE9 an\xE9cdotas de aquel entonces... A ver si recuerdas algo,
      amigo m\xEDo."
    expression: {fileID: 21300000, guid: 5a67d1d35e8d4a845b48cdba1b4a0b98, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Los primeros d\xEDas de 2o de la ESO, empezamos a buscar nuestro nuevo
      juguete."
    expression: {fileID: 21300000, guid: 01e209d0ba4cc38408aea47044a5b675, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Ah\xED fue cuando lo encontramos. Un chico bajito con gafas..."
    expression: {fileID: 21300000, guid: 01e209d0ba4cc38408aea47044a5b675, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Nada m\xE1s verlo, los dos pensamos lo mismo. Esa ser\xEDa nuestra pr\xF3xima
      v\xEDctima."
    expression: {fileID: 21300000, guid: 01e209d0ba4cc38408aea47044a5b675, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "La persona con la que jugar\xEDamos ese a\xF1o."
    expression: {fileID: 21300000, guid: 5a67d1d35e8d4a845b48cdba1b4a0b98, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Todav\xEDa recuerdo el primer juego al que jugamos..."
    expression: {fileID: 21300000, guid: 01e209d0ba4cc38408aea47044a5b675, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "En la hora del recreo, le llevamos al ba\xF1o... "
    expression: {fileID: 21300000, guid: f7f186458fc313941bac93e131be3506, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Le tiramos la comida al vater y le grabamos mientras se la com\xEDa..."
    expression: {fileID: 21300000, guid: f7f186458fc313941bac93e131be3506, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: JAJAJAJAJAJAJAJAJAJAJAJAJAJAJAJAJAJAJAJAJAJAJA
    expression: {fileID: 21300000, guid: 80104af068bcb94418a4b92c805738b5, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Me acuerdo que subimos el v\xEDdeo al foro del instituto... Me estuve
      riendo una semana entera sin parar."
    expression: {fileID: 21300000, guid: f7f186458fc313941bac93e131be3506, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 8cfa5884b22dc284bbf09abbad8a9188, type: 3}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 1
    options:
    - optionText: No mientas... Yo no hice eso...
      nextDialogue: {fileID: 11400000, guid: 3d84017ab04393e4491c141607c949b1, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
