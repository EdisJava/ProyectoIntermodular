  m_Script: {fileID: 11500000, guid: 2c258d7aa07a5574b92a767b18b37c32, type: 3}
  m_Name: FinalDialogo
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: (yo)
    text: Por fin estoy en casa.
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: c9c786b38a691f44b8ad4b83c54f871b, type: 3}
    hasOptions: 0
    options: []
  - characterName: (yo)
    text: "Estoy tan cansado... Todo esto de educaci\xF3n me est\xE1 volviendo loco."
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 109ca5eb81c5efe45a9e9c588c5de48a, type: 3}
    hasOptions: 0
    options: []
  - characterName: (yo)
    text: . . .
    expression: {fileID: 0}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: c9c786b38a691f44b8ad4b83c54f871b, type: 3}
    hasOptions: 0
    options: []
  - characterName: (yo)
    text: "Un momento... \xBFDej\xE9 la ventana abierta?"
    expression: {fileID: 0}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: c9c786b38a691f44b8ad4b83c54f871b, type: 3}
    hasOptions: 0
    options: []
  - characterName: (yo)
    text: "Supongo que me habr\xE9 olvidado... \xDAltimamente no he dormido nada."
    expression: {fileID: 0}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: c9c786b38a691f44b8ad4b83c54f871b, type: 3}
    hasOptions: 0
    options: []
