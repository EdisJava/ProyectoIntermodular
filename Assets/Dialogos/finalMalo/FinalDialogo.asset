  m_Script: {fileID: 11500000, guid: 2c258d7aa07a5574b92a767b18b37c32, type: 3}
  m_Name: FinalDialogo
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: "(t\xFA)"
    text: Por fin estoy en casa.
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: "(t\xFA)"
    text: Se me ha hecho muy larga esta semana...
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: "(t\xFA)"
    text: "Estoy tan cansado... Todo esto de educaci\xF3n me est\xE1 volviendo loco."
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 0
    options: []
  - characterName: "(t\xFA)"
    text: Necesito dormir pronto...
    expression: {fileID: 21300000, guid: 17b04b154ed836b4c918645fa5478925, type: 3}
    lineSound: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 1a58f7c2170f4924e8fdf9b8abbda060, type: 3}
    hasOptions: 1
    options:
    - optionText: (mirarte al espejo)
      nextDialogue: {fileID: 11400000, guid: 1ea7249a338c5984ba534402247534a2, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
    - optionText: (no hacerlo)
      nextDialogue: {fileID: 11400000, guid: 7c8dcb632dc3a3c49b86f9728577c4d9, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
