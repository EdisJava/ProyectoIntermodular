  lines:
  - characterName: Jesus
    text: Te refieres a ????? Jajajaja
    expression: {fileID: 21300000, guid: 70fedb3a3b533c245a55736e6bd3a4ab, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Lo he visto, Jajajajajaja
    expression: {fileID: 21300000, guid: 70fedb3a3b533c245a55736e6bd3a4ab, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: "Seguro que fue \xBF\xBF\xBF\xBF\xBF\xBF\xBF\xBF \xBFEs sospechoso no te
      parece? Seguro que es el tipico que va por ah\xED pegando a gente"
    expression: {fileID: 21300000, guid: ffdd1d146e4b34e42a62ab994b7748bd, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: No estaras insinuando que he sido yo no?
    expression: {fileID: 21300000, guid: bdc179761ef4d734798f2ac440ae6ec4, type: 3}
    hasOptions: 0
    options: []
  - characterName: Jesus
    text: Los amigos no acusan a sus amigos
    expression: {fileID: 21300000, guid: bdc179761ef4d734798f2ac440ae6ec4, type: 3}
    hasOptions: 0
    options: []
