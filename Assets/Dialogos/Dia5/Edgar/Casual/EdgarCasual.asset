  m_Script: {fileID: 11500000, guid: 2c258d7aa07a5574b92a767b18b37c32, type: 3}
  m_Name: EdgarCasual
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Edgar
    text: Belisariuuuus...
    expression: {fileID: 21300000, guid: 38eead89f192e5f4c80fe325d9360ada, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 0682f1301744ad04aa6ca2a0b5e3abf1, type: 3}
    backgroundOverride: {fileID: 0}
    hasOptions: 0
    options: []
  - characterName: Edgar
    text: "Joder... Que gran pel\xEDcula me vi ayer."
    expression: {fileID: 21300000, guid: 38eead89f192e5f4c80fe325d9360ada, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 0682f1301744ad04aa6ca2a0b5e3abf1, type: 3}
    backgroundOverride: {fileID: 0}
    hasOptions: 0
    options: []
  - characterName: Edgar
    text: "La he visto m\xEDnimo 50 veces. Se llama 300."
    expression: {fileID: 21300000, guid: 08109e029d10cc44f93a7d72178b067a, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 0682f1301744ad04aa6ca2a0b5e3abf1, type: 3}
    backgroundOverride: {fileID: 0}
    hasOptions: 0
    options: []
  - characterName: Edgar
    text: Te la recomiendo.
    expression: {fileID: 21300000, guid: 08109e029d10cc44f93a7d72178b067a, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 0682f1301744ad04aa6ca2a0b5e3abf1, type: 3}
    backgroundOverride: {fileID: 0}
    hasOptions: 1
    options:
    - optionText: "\xBFQu\xE9 te ha pasado?"
      nextDialogue: {fileID: 11400000, guid: 9338cfe2264ef474994bc16e49a8391e, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
    - optionText: "\xBFQui\xE9n te peg\xF3?"
      nextDialogue: {fileID: 11400000, guid: 9338cfe2264ef474994bc16e49a8391e, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
