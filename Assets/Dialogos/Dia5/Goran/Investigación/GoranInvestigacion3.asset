    typingVoice: {fileID: 0}
    backgroundOverride: {fileID: 0}
    hasOptions: 1
    isFinalButton: 0
    options:
    - optionText: "\xBFCon que Jesus eh...? Gracias por ayudarme Goran, nos vemos"
