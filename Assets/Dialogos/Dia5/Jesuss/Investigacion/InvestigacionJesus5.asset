  - characterName: Jesus
    text: Que quieres preguntarme.
    expression: {fileID: 21300000, guid: 70fedb3a3b533c245a55736e6bd3a4ab, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 0}
    backgroundOverride: {fileID: 0}
    hasOptions: 1
    isFinalButton: 0
    options:
    - optionText: "Recuerdas si viste a alguien meterse con Alberto al ba\xF1o de
        mujeres? (-1 punto)"
