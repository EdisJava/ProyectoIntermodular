  m_Script: {fileID: 11500000, guid: 2c258d7aa07a5574b92a767b18b37c32, type: 3}
  m_Name: ian_Investigation2_Dia1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Ian
    text: "No lo s\xE9. Acabo de llegar aqu\xED y no conozco a nadie... "
    expression: {fileID: 21300000, guid: 8ad2e8cafd562d94cb3e38f90f8c78a6, type: 3}
    hasOptions: 0
    options: []
  - characterName: Ian
    text: Espera... ahora que lo recuerdo, creo que vi a un chico muy raro hacerlo...
    expression: {fileID: 21300000, guid: f5dd10d162e8787448feb352ee8e7c43, type: 3}
    hasOptions: 0
    options: []
  - characterName: Ian
    text: "Ofrece caramelos a ni\xF1as peque\xF1as en la R04..."
    expression: {fileID: 21300000, guid: c839f78a7fbe4094f9d6eb45d6359655, type: 3}
    hasOptions: 0
    options: []
  - characterName: Ian
    text: Tiene un sombrero y gafas...
    expression: {fileID: 21300000, guid: c839f78a7fbe4094f9d6eb45d6359655, type: 3}
    hasOptions: 0
    options: []
  - characterName: Ian
    text: "Le ofrec\xED petunias pero me las rechaz\xF3..."
    expression: {fileID: 21300000, guid: c047a51ff1fdef644b455d539982fbbe, type: 3}
    hasOptions: 0
    options: []
