  lines:
  - characterName: Acharki
    text: . . .
    expression: {fileID: 21300000, guid: 42f51696b297c7c45ac2db34f3766b74, type: 3}
    hasOptions: 0
    options: []
  - characterName: Acharki
    text: Es mosca fuerte.
    expression: {fileID: 21300000, guid: 42f51696b297c7c45ac2db34f3766b74, type: 3}
    hasOptions: 0
    options: []
  - characterName: Acharki
    text: "Lo ves moro? Lo que te dec\xEDa..."
    expression: {fileID: 21300000, guid: 9bb335164a8cc6a438e3c94bd60994e9, type: 3}
    hasOptions: 0
    options: []
  - characterName: Acharki
    text: Las mujeres no te dan la felicidad... Te la prestan.
    expression: {fileID: 21300000, guid: 9bb335164a8cc6a438e3c94bd60994e9, type: 3}
    hasOptions: 0
    options: []
  - characterName: Acharki
    text: Y cuando te acostumbras, te la quitan...
    expression: {fileID: 21300000, guid: 42f51696b297c7c45ac2db34f3766b74, type: 3}
    hasOptions: 0
    options: []
