  lines:
  - characterName: Acharki
    text: Hmmm...
    expression: {fileID: 21300000, guid: 42f51696b297c7c45ac2db34f3766b74, type: 3}
    hasOptions: 0
    options: []
  - characterName: Acharki
    text: "No me extra\xF1a que le hayan pegado."
    expression: {fileID: 21300000, guid: 42f51696b297c7c45ac2db34f3766b74, type: 3}
    hasOptions: 0
    options: []
  - characterName: Acharki
    text: "La cosa es qui\xE9n lo hizo."
    expression: {fileID: 21300000, guid: 9bb335164a8cc6a438e3c94bd60994e9, type: 3}
    hasOptions: 0
    options: []
  - characterName: Acharki
    text: "Creo que Pablo no se lleva muy bien con \xE9l..."
    expression: {fileID: 21300000, guid: ccd9e9e3736351645b9fe1b532750caa, type: 3}
    hasOptions: 0
    options: []
  - characterName: Acharki
    text: "No te f\xEDes de nadie por aqu\xED."
    expression: {fileID: 21300000, guid: 42f51696b297c7c45ac2db34f3766b74, type: 3}
    hasOptions: 0
    options: []
  - characterName: Acharki
    text: "Ni de t\xED mismo..."
    expression: {fileID: 21300000, guid: ccd9e9e3736351645b9fe1b532750caa, type: 3}
    hasOptions: 0
    options: []
