  m_Script: {fileID: 11500000, guid: 2c258d7aa07a5574b92a767b18b37c32, type: 3}
  m_Name: AdayCasual
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Aday
    text: Vaya mierda de semana...
    expression: {fileID: 21300000, guid: 2a97a01237af0b543bccd771a473a6b2, type: 3}
    hasOptions: 0
    options: []
  - characterName: Aday
    text: Primero, un loco asesina a toda mi familia...
    expression: {fileID: 21300000, guid: 2a97a01237af0b543bccd771a473a6b2, type: 3}
    hasOptions: 0
    options: []
  - characterName: Aday
    text: "Y luego se cae la p\xE1gina de manga..."
    expression: {fileID: 21300000, guid: 2a97a01237af0b543bccd771a473a6b2, type: 3}
    hasOptions: 0
    options: []
  - characterName: Aday
    text: Joder...
    expression: {fileID: 21300000, guid: a5e494c44e4e7b5419a7fb75d711dced, type: 3}
    hasOptions: 0
    options: []
  - characterName: Aday
    text: Ya no tengo donde leer manguita...
    expression: {fileID: 21300000, guid: a5e494c44e4e7b5419a7fb75d711dced, type: 3}
    hasOptions: 1
    options:
    - optionText: "\xBFEres tonto?"
      nextDialogue: {fileID: 11400000, guid: 01ab01e2f7ca23b408c57dab5a8c5783, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
    - optionText: Eres un rarito
      nextDialogue: {fileID: 11400000, guid: b4c5dc72e858d9b489ac44792c1b8293, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
