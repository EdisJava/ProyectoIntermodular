    hasOptions: 0
    isFinalButton: 0
    options: []
  - characterName: Maria
    text: "\xBFYa sabes algo sobre lo de Haydin?"
    expression: {fileID: 21300000, guid: 8fc3fe3ba9623cb479cb836e93330310, type: 3}
    lineSound: {fileID: 0}
    typingVoice: {fileID: 8300000, guid: 95c15080ea5b9984d971388234de22ef, type: 3}
    backgroundOverride: {fileID: 0}
    hasOptions: 1
    isFinalButton: 0
    options:
    - optionText: "Si, ya tengo la elecci\xF3n."
