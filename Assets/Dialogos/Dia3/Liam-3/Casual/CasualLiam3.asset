  lines:
  - characterName: Liam
    text: Mi estimado, porque permiten caninos en este centro. Aunque como hombre
      performativo, no me importa.
    expression: {fileID: 21300000, guid: 58c72e1670d198641a0c0c44e18dad30, type: 3}
    hasOptions: 1
    options:
    - optionText: Es Walter, un dia aparecio por aqui y ya no se fue.
      nextDialogue: {fileID: 11400000, guid: b36b11c42fd7884438e61fadbe0ae302, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
    - optionText: Mi estimado, gracias por la informacion de ayer.
      nextDialogue: {fileID: 11400000, guid: 9d54cb10caefabe49a12aeaa557bf181, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
