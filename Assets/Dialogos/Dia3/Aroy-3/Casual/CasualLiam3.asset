  lines:
  - characterName: Aroy
    text: Hola, porque permiten perros en este centro. Aunque como hombre performativo,
      no me importa.
    expression: {fileID: 21300000, guid: 7de5b54c4a667254f995e5c58d9c0e04, type: 3}
    hasOptions: 1
    options:
    - optionText: Es Walter, un dia aparecio por aqui y ya no se fue.
      nextDialogue: {fileID: 11400000, guid: b36b11c42fd7884438e61fadbe0ae302, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
    - optionText: Como estas de los moretones.
      nextDialogue: {fileID: 11400000, guid: 9d54cb10caefabe49a12aeaa557bf181, type: 2}
      isInterrogation: 0
      isFinalDecision: 0
      isCorrectAccusation: 0
