  lines:
  - characterName: Boberto
    text: . . .
    expression: {fileID: 21300000, guid: 39b7da4a823199d45a3524fa504599c0, type: 3}
    hasOptions: 0
    options: []
  - characterName: Boberto
    text: "\xBFDe qu\xE9 hablas?"
    expression: {fileID: 21300000, guid: b0ea2a274d248394dade1094f58fb09f, type: 3}
    hasOptions: 0
    options: []
  - characterName: Boberto
    text: "\xBFTe refieres a lo que le pas\xF3 Aroy?"
    expression: {fileID: 21300000, guid: b0ea2a274d248394dade1094f58fb09f, type: 3}
    hasOptions: 0
    options: []
  - characterName: Boberto
    text: "No s\xE9 nada..."
    expression: {fileID: 21300000, guid: b0ea2a274d248394dade1094f58fb09f, type: 3}
    hasOptions: 0
    options: []
  - characterName: Boberto
    text: Nada de nada...
    expression: {fileID: 21300000, guid: 39b7da4a823199d45a3524fa504599c0, type: 3}
    hasOptions: 0
    options: []
  - characterName: Boberto
    text: "Yo solo us\xE9 mi saco de boxeo personal."
    expression: {fileID: 21300000, guid: 39b7da4a823199d45a3524fa504599c0, type: 3}
    hasOptions: 0
    options: []
  - characterName: Boberto
    text: "Quiz\xE1s solo se cay\xF3."
    expression: {fileID: 21300000, guid: b0ea2a274d248394dade1094f58fb09f, type: 3}
    hasOptions: 0
    options: []
