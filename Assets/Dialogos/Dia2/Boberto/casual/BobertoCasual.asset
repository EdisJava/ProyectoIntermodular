  lines:
  - characterName: Boberto
    text: Hoy estoy aliviado...
    expression: {fileID: 21300000, guid: b0ea2a274d248394dade1094f58fb09f, type: 3}
    hasOptions: 0
    options: []
  - characterName: Boberto
    text: He tenido una semana dura y ayer pude desestresarme...
    expression: {fileID: 21300000, guid: b0ea2a274d248394dade1094f58fb09f, type: 3}
    hasOptions: 0
    options: []
  - characterName: Boberto
    text: Estoy como nuevo.
    expression: {fileID: 21300000, guid: b0ea2a274d248394dade1094f58fb09f, type: 3}
    hasOptions: 1
    options:
    - optionText: "\xBFC\xF3mo lo hiciste?"
