  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c258d7aa07a5574b92a767b18b37c32, type: 3}
  m_Name: ErmisDecisionAA
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Ermis
    text: "Estoy muy decepcionado. No me lo esperaba de \xE9l."
    expression: {fileID: 21300000, guid: 17699742146844243ac1cdb93b06e522, type: 3}
    hasOptions: 0
    options: []
  - characterName: Ermis
    text: "Le expulsar\xE9 inmediatamente."
    expression: {fileID: 21300000, guid: 43640beb0febedd4d8e5e9fe43a2b07a, type: 3}
    hasOptions: 0
    options: []
  - characterName: Ermis
    text: "Tambi\xE9n hablar\xE9 con sus padres para que hagan terapia de Odoo."
    expression: {fileID: 21300000, guid: 43640beb0febedd4d8e5e9fe43a2b07a, type: 3}
    hasOptions: 0
    options: []
  - characterName: Ermis
    text: Seguro con eso mejora como persona.
    expression: {fileID: 21300000, guid: 43640beb0febedd4d8e5e9fe43a2b07a, type: 3}
    hasOptions: 0
    options: []
  - characterName: Ermis
    text: Ya puedes volver a casa. Muchas gracias por la ayuda.
    expression: {fileID: 21300000, guid: 43640beb0febedd4d8e5e9fe43a2b07a, type: 3}
    hasOptions: 0
    options: []
